  - skillName: "\u85AA\u708E\u738B\u5251\u7684\u51EF\u65CB"
    level: 0
    textStats:
      Introduction: "\u53D1\u52A8\u4E00\u6B21\u5F3A\u529B\u7684\u653B\u51FB"
      Description: "\u5F00\u542F\u6D88\u8017\u80FD\u91CF\u503C\uFF1A75\uFF0C\u51B7\u5374\u65F6\u95F4\uFF1A16\u79D2
        \u5BF9\u654C\u4EBA\u9020\u62102150%\u653B\u51FB\u529B\u7684\u706B\u7130\u5143\u7D20\u4F24\u5BB3\uFF0C\u671F\u95F4\u89D2\u8272\u5904
        \u4E8E\u5F8B\u8005\u5F62\u6001\u5E76\u89E6\u53D1\u65F6\u6EDE\u9886\u57DF\u6548\u679C\uFF0C\u89D2\u8272\u3001\u654C\u4EBA\u8EAB\u4E0A\u7684\u6280
        \u80FD\u6548\u679C\u4EE5\u53CA\u5173\u5361\u90FD\u4F1A\u505C\u6B62\u8BA1\u65F6\u3002\u82E5\u5F00\u542F\u524D\u5904\u4E8E\u5F8B\u8005\u5F62\u6001
        \uFF0C\u5FC5\u6740\u6280\u91CA\u653E\u540E\u5F8B\u8005\u5F62\u6001\u7ED3\u675F"
    branches:
    - branchName: "\u4EE5\u6B64\u85AA\u708E\u707C\u70C1"
      level: 0
      textStats:
        Introduction: "\u8FC7\u70ED\u671F\u95F4\u89D2\u8272\u5904\u4E8E\u573A\u4E0B\u65F6\u56DE\u590D\u80FD\u91CF\u503C"
        Description: 
