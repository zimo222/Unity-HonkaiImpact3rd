        Description: 
  - skillName: "\u71CE\u539F\u708E\u8F66\u7684\u72FC\u70DF"
    level: 0
    textStats:
      Introduction: "\u70ED\u91CF\u4E3A\u65F6\u53EF\u4EE5\u4F7F\u7528\uFF0C\u53D1\u52A8\u5F3A\u529B\u7684\u653B\u51FB"
      Description: "\u70ED\u91CF\uFF1A\u521D\u59CB0\u70B9\uFF0C\u975E\u8FC7\u70ED\u65F6\u6BCF\u79D2\u964D\u4F4E21\u70B9\uFF0C\u8FC7\u70ED\u65F6\u6BCF\u79D2\u964D
        \u4F4E10\u70B9 \u666E\u901A\u5F62\u6001\u5206\u652F\uFF1A\u63D0\u9AD845\u70B9\u70ED\u91CF\uFF0C\u6D88\u8017\u5F53\u524D\u751F\u547D\u503C\u768415%
        \uFF0C\u9020\u6210300%\u653B\u51FB\u529B\u7684\u706B\u7130\u5143\u7D20\u4F24\u5BB3\uFF0C\u89E6\u53D1\u6301\u7EED2.5\u79D2\u7684
        \u5168\u5C40\u65F6\u7A7A\u65AD\u88C2\u5E76\u8FDB\u5165\u6301\u7EED11.5\u79D2\u7684\u5F8B\u8005\u5F62\u6001
        \u5F8B\u8005\u5F62\u6001\u671F\u95F4\u89D2\u8272\u62DB\u5F0F\u53D8\u5316\uFF0C\u6297\u6253\u65AD\u529B\u63D0\u9AD8\uFF0C\u6BCF\u79D2\u6D88\u8017
        \u5F53\u524D\u751F\u547D\u503C\u76841% \u5F8B\u8005\u5F62\u6001\u5206\u652F\uFF1A\u63D0\u9AD8100\u70B9\u70ED\u91CF\u5E76\u89E6\u53D1\u6301\u7EED3.5\u79D2\u7684\u5168\u5C40
        \u65F6\u7A7A\u65AD\u88C2 \u5730\u9762\uFF1A\u51711200%\u653B\u51FB\u529B\u7684\u706B\u7130\u5143\u7D20\u4F24\u5BB3
        \u7A7A\u4E2D: \u5C06\u654C\u4EBA\u6D6E\u7A7A\u5E76\u751F\u6210\u9ED1\u6D1E\u5438\u5F15\u654C\u4EBA\uFF0C\u9020\u6210\u51711200%\u653B\u51FB\u529B
        \u7684\u706B\u7130\u5143\u7D20\u4F24\u5BB3 \u5F8B\u8005\u5F62\u6001\u7ED3\u675F\u540E\uFF0C\u89D2\u8272\u8FDB\u5165\u8FC7\u70ED\uFF0C\u63D0\u9AD8100\u70B9\u70ED\u91CF
        \u79BB\u573A\u65F6\uFF0C\u5C06\u8131\u79BB\u5F8B\u8005\u5F62\u6001"
