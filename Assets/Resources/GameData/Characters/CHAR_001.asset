  skills:
  - skillName: "\u65E0\u540D\u6E38\u4FA0\u7684\u65C5\u9014"
    level: 0
    textStats:
      Introduction: "\u7F6E\u4E8E\u961F\u957F\u4F4D\u65F6\uFF0C\u5168\u961F\u53D7\u5230\u52A0\u6210"
      Description: "\u961F\u957F\u6280\uFF1A\u5168\u961F\u5168\u5143\u7D20\u4F24\u5BB3\u63D0\u9AD848.0%\uFF0C\u961F\u4F0D\u4E2D\u6BCF\u6709\u4E00\u4E2A\u975E\u742A\u4E9A\u5A1C\u89D2\u8272\uFF0C\u5168\u961F\u521D\u59CB\u80FD\u91CF\u503C\u63D0\u9AD830.0\u70B9\uFF08\u6700\u591A60.0
        \u70B9\uFF0C\u8BE5\u6548\u679C\u5728\u5F00\u653E\u4E16\u754C\u4E2D\u6BCF10\u5206\u949F\u53EF\u4EE5\u89E6\u53D11\u6B21\uFF09"
    branches:
    - branchName: "\u65E0\u540D\u6E38\u4FA0\u7684\u65C5\u9014"
      level: 0
      textStats:
        Introduction: "\u5168\u961F\u5143\u7D20\u4F24\u5BB3\u63D0\u9AD8\uFF1B\u961F\u4F0D\u4E2D\u6BCF\u6709\u4E00\u4E2A\u975E\u742A\u4E9A\u5A1C\u89D2\u8272\uFF0C\u5168\u961F\u521D\u59CB\u80FD\u91CF\u503C\u63D0\u9AD8"
        Description: 
  - skillName: "\u70C8\u7130\u5723\u6B4C\u7684\u8A93\u7EA6"
    level: 0
    textStats:
      Introduction: "\u89D2\u8272\u81EA\u52A8\u53D7\u88AB\u52A8\u6280\u80FD\u52A0\u6210"
      Description: "\u85AA\u708E\u4E4B\u5F8B\u8005\u7684\u666E\u901A\u653B\u51FB\u548C\u5206\u652F\u653B\u51FB\u3001\u961F\u53CB\u7684\u84C4\u529B\u653B\u51FB\u6216\u5206\u652F\u653B\u51FB\u4F1A\u5BF9\u654C\u4EBA\u65BD\u52A0\u3010\u85AA\u70EC\u6807\u8BB0\u3011\uFF0C\u6301\u7EED6\u79D2
        \u5F8B\u8005\u5F62\u6001\u4E0B\u65BD\u52A0\u7684\u3010\u85AA\u70EC\u6807\u8BB0\u3011\u4F1A\u6BCF0.5\u79D2\u5BF9\u654C\u4EBA\u9020\u6210\u89D2\u82725%\u653B\u51FB\u529B\u7684\u706B\u7130\u5143\u7D20\u4F24\u5BB3\uFF0C\u4F24\u5BB3\u6548\u679C\u53EF\u53E0\u52A010\u6B21
        \u90E8\u5206\u62DB\u5F0F\u4F1A\u5F15\u7206\u5927\u8303\u56F4\u5185\u654C\u4EBA\u8EAB\u4E0A\u7684\u6807\u8BB0\uFF08\u4E0D\u4F1A\u6D88\u8017\u6807\u8BB0\uFF09\uFF0C\u9020\u6210120%\u653B\u51FB\u529B\u7684\u706B\u7130\u5143\u7D20\u4F24\u5BB3\uFF1A
        \u5F8B\u8005\u5F62\u6001\u666E\u653B\u6700\u540E\u4E00\u51FB\uFF08\u8BE5\u65B9\u5F0F\u6BCF2\u79D2\u53EF\u4EE5\u89E6\u53D11\u6B21\uFF09\u3001
        QTE\u3001\u666E\u901A\u5F62\u6001\u5730\u9762\u666E\u653B\u6700\u540E\u4E00\u51FB\u3001\u5206\u652F\u653B\u51FB
        \u82E5\u5904\u4E8E\u8FC7\u70ED\u72B6\u6001\uFF0C\u70ED\u91CF\u503C\u964D\u4F4E15\u70B9\uFF0C\u6BCF2\u79D2\u53EF\u4EE5\u89E6\u53D11\u6B21"
    branches:
    - branchName: "\u4EE5\u6B64\u9882\u8BD7\u5B58\u62A4"
      level: 0
      textStats:
        Introduction: "\u89D2\u8272\u56DE\u590D\u7684\u751F\u547D\u503C\u8F6C\u5316\u4E3A\u5C4F\u969C\uFF0C\u5C4F\u969C\u5B58\u5728\u65F6\u4F24\u5BB3\u63D0\u9AD8"
        Description: 
    - branchName: "\u7EFD\u66AE\u5149\u4E4B\u7948\u795D"
      level: 0
      textStats:
        Introduction: "\u5F8B\u8005\u5F62\u6001\u4E0B\u89D2\u8272\u83B7\u5F97\u5F3A\u5316"
        Description: 
    - branchName: "\u7E41\u661F\u71A0\u715C"
      level: 0
      textStats:
        Introduction: "\u79BB\u573A\u65F6\u5BF9\u654C\u4EBA\u9020\u6210\u4F24\u5BB3\u5E76\u5C06\u5176\u62C9\u81F3\u5730\u9762"
        Description: 
  - skillName: "\u9057\u4E16\u706B\u9E1F\u7684\u71C3\u7FBD"
    level: 0
    textStats:
      Introduction: "\u5FEB\u901F\u4F4D\u79FB\u8EB2\u907F\u654C\u4EBA\u653B\u51FB"
      Description: "\u6781\u9650\u95EA\u907F\uFF1A\u89E6\u53D1\u6301\u7EED4\u79D2\u7684\u5168\u5C40\u65F6\u7A7A\u65AD\u88C2\uFF0C\u51B7\u5374\u65F6\u95F418\u79D2
        \u5730\u9762\uFF1A\u53EF\u8FDE\u95EA2\u6B21 \u7A7A\u4E2D: \u666E\u901A\u5F62\u6001\uFF1A\u53EA\u53EF\u95EA\u907F1\u6B21
        \u5F8B\u8005\u5F62\u6001\uFF1A\u53EF\u4EFB\u610F\u95EA\u907F\uFF0C\u4E14\u4E4B\u540E\u77ED\u65F6\u95F4\u5185\u6309\u653B\u51FB\u952E\u53EF\u76F4
        \u63A5\u4F7F\u7528\u666E\u653B\u7B2C\u4E09\u51FB \u5F8B\u8005\u5F62\u6001\u4E0B\u6781\u9650\u95EA\u907F\u6210\u529F\u65F6\uFF0C\u5BF9\u5468\u56F4\u5927\u8303\u56F4\u5185\u654C\u4EBA\u65BD\u52A0
        5\u5C42\u3010\u85AA\u70EC\u6807\u8BB0\u3011\uFF0C\u5E76\u56DE\u590D2\u70B9\u80FD\u91CF\u503C\uFF0C\u6BCF10\u79D2\u53EF\u4EE5\u89E6\u53D1
        \u4E00\u6B21"
    branches:
    - branchName: "\u4EE5\u6B64\u4F59\u706B\u94ED\u8BB0"
      level: 0
      textStats:
        Introduction: "\u975E\u6781\u9650\u95EA\u907F\u4E5F\u53EF\u89E6\u53D1\u6781\u9650\u95EA\u907F\u6280\u80FD\u7684\u6548\u679C"
        Description: 
    - branchName: "\u5C18\u6E21\u5343\u5E74"
      level: 0
      textStats:
        Introduction: "\u961F\u4F0D\u4E2D\u5176\u4ED6\u89D2\u8272\u5206\u522B\u4F7F\u7528\u6307\u5B9A\u653B\u51FB\u51FB\u4E2D\u654C\u4EBA\u65F6\u53EF\u89E6\u53D1QTE"
        Description: 
    - branchName: "QTE-\u5524\u954C\u7FCE\u4E4B\u65B0\u751F"
      level: 0
      textStats:
        Introduction: "QTE\uFF1A\u654C\u4EBA\u88AB\u70B9\u71C3\u6216\u6D6E\u7A7A\u89E6\u53D1"
        Description: 
  - skillName: "\u6DEC\u706B\u5251\u58EB\u7684\u5251\u88AD"
    level: 0
    textStats:
      Introduction: "\u4F7F\u7528\u5927\u5251\u653B\u51FB\u654C\u4EBA\uFF0C\u9020\u6210\u5FAE\u91CF\u70B9\u71C3\u79EF\u84C4\u503C"
      Description: "\u5730\u9762: \u666E\u901A\u5F62\u6001\uFF1A\u5171\u9020\u6210730%\u653B\u51FB\u529B\u7684\u706B\u7130\u5143\u7D20\u4F24\u5BB3
        \u5F8B\u8005\u5F62\u6001\uFF1A\u5171\u9020\u6210970%\u653B\u51FB\u529B\u7684\u706B\u7130\u5143\u7D20\u4F24\u5BB3
        \u7A7A\u4E2D\uFF1A \u666E\u901A\u5F62\u6001\uFF1A\u5171\u9020\u6210490%\u653B\u51FB\u529B\u7684\u706B\u7130\u5143\u7D20\u4F24\u5BB3
        \u5F8B\u8005\u5F62\u6001\uFF1A\u5171\u9020\u6210900%\u653B\u51FB\u529B\u7684\u706B\u7130\u5143\u7D20\u4F24\u5BB3
        \u4E0A\u6311\u653B\u51FB\uFF1A\u9020\u6210200%\u653B\u51FB\u529B\u7684\u706B\u7130\u5143\u7D20\u4F24\u5BB3
        \u4E0B\u7838\u653B\u51FB\uFF1A\u9020\u6210\u591A\u6BB530%+90%*2\u653B\u51FB\u529B\u7684\u706B\u7130\u5143\u7D20\u4F24
        \u5BB3"
    branches:
    - branchName: "\u4EE5\u6B64\u5251\u5149\u6267\u63E1"
      level: 0
